#HTC Submission File for SFrameBatch
# +MyProject        =  "af-cms"
#Requirements = ( OpSysAndVer == "CentOS7" )
#Requirements = ( OpSysAndVer == "AlmaLinux9" )
+MySingularityImage="/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el7:x86_64"
+MySingularityArgs="--bind /tmp:/tmp"

universe          = vanilla
# #Running in local mode with 8 cpu slots
# universe          =  local
# request_cpus      =  8
notification      = Error
notify_user       = bozek3@uic.edu
initialdir        = workdir_Analysis_EFT_UL17_muon_semilepton_deltayreco_ttree
output            = $(Stream)/MC_EFT_Mttbar_700-900_UL17.o$(ClusterId).$(Process)
error             = $(Stream)/MC_EFT_Mttbar_700-900_UL17.e$(ClusterId).$(Process)
log               = $(Stream)/MC_EFT_Mttbar_700-900_UL17.$(Cluster).log
#Requesting CPU and DISK Memory - default +RequestRuntime of 3h stays unaltered
RequestMemory     = 2G
RequestDisk       = 2G
#You need to set up sframe
getenv            = True
environment       = "LD_LIBRARY_PATH_STORED=/data/dust/user/titasroy/Ac_UL/SFrame/lib:/data/dust/user/titasroy/Ac_UL/CMSSW_10_6_28/biglib/slc7_amd64_gcc700:/data/dust/user/titasroy/Ac_UL/CMSSW_10_6_28/lib/slc7_amd64_gcc700:/data/dust/user/titasroy/Ac_UL/CMSSW_10_6_28/external/slc7_amd64_gcc700/lib:/cvmfs/cms.cern.ch/slc7_amd64_gcc700/cms/cmssw/CMSSW_10_6_28/biglib/slc7_amd64_gcc700:/cvmfs/cms.cern.ch/slc7_amd64_gcc700/cms/cmssw/CMSSW_10_6_28/lib/slc7_amd64_gcc700:/cvmfs/cms.cern.ch/slc7_amd64_gcc700/cms/cmssw/CMSSW_10_6_28/external/slc7_amd64_gcc700/lib:/cvmfs/cms.cern.ch/slc7_amd64_gcc700/external/llvm/7.1.0-pafccj/lib64:/cvmfs/cms.cern.ch/slc7_amd64_gcc700/external/gcc/7.0.0-pafccj/lib64:/cvmfs/cms.cern.ch/slc7_amd64_gcc700/external/gcc/7.0.0-pafccj/lib:/cvmfs/cms.cern.ch/slc7_amd64_gcc700/external/cuda/10.1.105-pafccj2/drivers:/.singularity.d/libs PATH_STORED=/data/dust/user/titasroy/Ac_UL/SFrame/bin:/cvmfs/cms.cern.ch/share/overrides/bin:/data/dust/user/titasroy/Ac_UL/CMSSW_10_6_28/bin/slc7_amd64_gcc700:/data/dust/user/titasroy/Ac_UL/CMSSW_10_6_28/external/slc7_amd64_gcc700/bin:/cvmfs/cms.cern.ch/slc7_amd64_gcc700/cms/cmssw/CMSSW_10_6_28/bin/slc7_amd64_gcc700:/cvmfs/cms.cern.ch/slc7_amd64_gcc700/cms/cmssw/CMSSW_10_6_28/external/slc7_amd64_gcc700/bin:/cvmfs/cms.cern.ch/slc7_amd64_gcc700/external/llvm/7.1.0-pafccj/bin:/cvmfs/cms.cern.ch/slc7_amd64_gcc700/external/gcc/7.0.0-pafccj/bin:/cvmfs/cms.cern.ch/slc7_amd64_gcc700/external/gsl/2.2.1-pafccj2/bin:/cvmfs/cms.cern.ch/common:/cvmfs/cms.cern.ch/common:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/data/dust/user/titasroy/Ac_UL/CMSSW_10_6_28/src/SFrameBatch/"
JobBatchName      = MC_EFT_Mttbar_700-900_UL17
executable        = workdir_Analysis_EFT_UL17_muon_semilepton_deltayreco_ttree/sframe_wrapper.sh
MyIndex           = $(Process) + 1
fileindex         = $INT(MyIndex,%d)
arguments         = MC_EFT_Mttbar_700-900_UL17_$(fileindex).xml
